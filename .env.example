# =============================================================================
# AI Engineering Learning Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
#
# Required variables depend on your chosen LLM provider:
#   LLM_PROVIDER=groq   → set GROQ_API_KEY
#   LLM_PROVIDER=ollama → set OLLAMA_BASE_URL (default: http://localhost:11434)
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# LLM provider
# Supported values: groq | ollama
# ----------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Groq
GROQ_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# Vector store (Qdrant)
# ----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_assistant

# ----------------------------------------------------------------------------
# Relational database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_assistant

# ----------------------------------------------------------------------------
# Observability (LangSmith)
# Set LANGCHAIN_TRACING_V2=true to enable tracing.
# ----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-assistant
LANGCHAIN_TRACING_V2=false
